# SwampForce data folder.
# database.json is public (the site reads it); it is never cached, so a new entry shows on the next page load.
Options -Indexes
<IfModule mod_headers.c>
  <Files "database.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
# Temporary files written while saving are never served.
<FilesMatch "^\.database-">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
